# Copy this file to .env and fill in your values

# Your agent's local server settings
AGENT_HOST=0.0.0.0
AGENT_PORT=9000
AGENT_LOG_LEVEL=info

# The public URL of your agent server
# Use ngrok or similar to expose localhost to the internet
# Example: https://abc123.ngrok-free.app
AGENT_PUBLIC_URL=https://your-ngrok-url.ngrok-free.app

# The Battle Royale platform URL
PLATFORM_URL=http://localhost:8000

# Your wallet address (optional — used for auto-registration scripts)
WALLET_ADDRESS=0xYourWalletAddressHere
